// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoReviewType {
  BUY
  SELL
  HOME
}

enum Status {
  ACTIVE
  INACTIVE
}

enum UserType {
  SUPERADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InventoryStatus {
  NOT_LISTED
  LISTED
  SOLD
}

enum PaymentMode {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  SPLIT_PAYMENT
  RAZORPAY
}

enum BuyingCondition {
  UNBOXED
  SUPERB
  GOOD
  FAIR
  PARTIALLY_FAIR
  BRAND_NEW_UNACTIVATED
}

enum BuyingAvailability {
  IN_STOCK
  OUT_OF_STOCK
}

enum BuyingOS {
  WINDOWS
  MACOS
}

enum WarrantyType {
  HELLOFI_WARRANTY
  BRAND_WARRANTY
  NO_WARRANTY
}

enum SaleType {
  DIRECT
  EXCHANGE
}

enum InvoiceWarrantyType {
  BRAND
  HELLOFI
  NONE
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

model User {
  id       String     @id @default(cuid())
  fName    String
  lName    String
  contact  String?    @unique
  password String?
  email    String?    @unique
  userType UserType   @default(USER)
  status   UserStatus @default(ACTIVE)

  emailVerified   Boolean @default(false)
  contactVerified Boolean @default(false)

  dailyOtpAttempts Int       @default(0)
  lastOtpDate      DateTime?
  isOtpBlocked     Boolean   @default(false)
  pincode          String

  dailyResendOtpAttempts Int       @default(0)
  lastResendDate         DateTime?
  isResendBlocked        Boolean   @default(false)

  dailyVerificationOtpAttempts Int       @default(0)
  lastVerificationDate         DateTime?
  isVerificationBlocked        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  sessions      Session[]
  sellingOrders SellingOrder[]

  @@index([email])
  @@index([contact])
  @@map("users")
}

model Session {
  id                  String   @id @default(cuid())
  sessionToken        String   @unique
  refreshToken        String?  @unique
  userId              String
  expires             DateTime
  sessionTokenExpires DateTime

  deviceId   String?
  deviceInfo String?
  ipAddress  String?

  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([refreshToken])
  @@map("sessions")
}

model Category {
  id           String   @id @default(uuid())
  name         String
  seoName      String   @unique
  categoryType String
  image        String
  priority     Int
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buyingProducts    BuyingProduct[]
  brandCategories   BrandCategory[]
  inventoryProducts InventoryProduct[]
  series            Series[]
  sellingProducts   SellingProduct[]
  assessments       Assessment[]
  sellingOrders     SellingOrder[]
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  seoName   String   @unique
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyingProducts    BuyingProduct[]
  brandCategories   BrandCategory[]
  inventoryProducts InventoryProduct[]
  series            Series[]
  sellingProducts   SellingProduct[]
  sellingOrders     SellingOrder[]
}

model BrandCategory {
  id         String   @id @default(uuid())
  brandId    String
  categoryId String
  status     Status   @default(ACTIVE)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([brandId, categoryId])
}

enum FeaturedSection {
  NONE
  MOST_LOVED
  PEOPLE_LOVE
}

model BuyingProduct {
  id              String          @id @default(uuid())
  productName     String
  productSubtitle String
  slug            String          @unique
  brandId         String?
  manualBrand     String?
  categoryId      String
  featuredSection FeaturedSection @default(NONE)
  isTrending      Boolean         @default(false)
  isTopSelling    Boolean         @default(false)
  isGaming        Boolean         @default(false)
  isMegaDhamaka   Boolean         @default(false)
  isLuxe          Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  brand          Brand?                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category       Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants       BuyingVariant[]
  specifications BuyingSpecification[]

  @@index([categoryId, featuredSection])
  @@index([categoryId, isTopSelling])
  @@index([categoryId, isTrending])
  @@index([categoryId, isMegaDhamaka])
  @@index([categoryId, isLuxe])
}

model BuyingVariant {
  id                  String             @id @default(uuid())
  productId           String
  sku                 String             @unique
  inventoryProductId  String?            @unique
  variantSubtitle     String
  liveLink            String?
  color               String?
  colorCode           String?
  storage             String?
  ram                 String?
  price               Decimal
  mrp                 Decimal
  emiBasePrice        Decimal?
  quantity            Int
  reservedQuantity    Int                @default(0)
  productSpec         String?
  condition           BuyingCondition
  availability        BuyingAvailability @default(IN_STOCK)
  screenSize          String?
  os                  BuyingOS?
  processor           String?
  batteryCapacity     String?
  warrantyType        WarrantyType
  warrantyDescription String?
  whatsInTheBox       String[]
  whatsExtra          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  product          BuyingProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images           BuyingProductImage[]
  inventoryProduct InventoryProduct?    @relation(fields: [inventoryProductId], references: [id], onDelete: SetNull) // ← add this
}

model BuyingProductImage {
  id        String   @id @default(uuid())
  variantId String
  xs        String?
  sm        String?
  md        String?
  lg        String?
  alt       String?
  priority  Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant BuyingVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model BuyingSpecification {
  id        String   @id @default(uuid())
  productId String
  key       String
  value     String
  group     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product BuyingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryProduct {
  id           String @id @default(uuid())
  imeiOrSerial String
  orderId      String

  purchaseDate        DateTime
  productName         String
  ram                 String?
  storage             String?
  costPrice           Decimal
  otherCharges        Decimal  @default(0)
  sellingOtherCharges Decimal  @default(0)

  brandId    String?
  categoryId String

  customerName    String
  customerEmail   String?
  customerPhone   String
  customerAddress String

  status InventoryStatus @default(NOT_LISTED)

  sellingDate  DateTime?
  sellingPrice Decimal?
  invoice      String?

  sellingCustomerName    String?
  sellingCustomerEmail   String?
  sellingCustomerPhone   String?
  sellingCustomerAddress String?

  paymentMode         PaymentMode?
  receivedInBank      Decimal?
  splitPaymentDetails String?

  tat         Int?
  grossProfit Decimal?

  screenCondition String  @default("NO")
  bodyCondition   String  @default("NO")
  deviceIssues    String?

  hasBox          Boolean @default(false)
  hasCharger      Boolean @default(false)
  hasOriginalBill Boolean @default(false)

  warrantyType         String    @default("ABOVE_1_YEAR")
  warrantyPurchaseDate DateTime?

  isActive Boolean @default(true)
  notes    String?

  // ── Exchange chain fields ──
  isExchangeItem Boolean  @default(false)
  exchangeValue  Decimal? // ← value credited to customer for this device

  // ── Direct parent — the sold device this was exchanged against ──
  parentInventoryId String?
  parentInventory   InventoryProduct?  @relation("ExchangeChain", fields: [parentInventoryId], references: [id])
  exchangedItems    InventoryProduct[] @relation("ExchangeChain")

  // ── Root of the chain — same for ALL nodes, enables flat fetch of entire chain ──
  rootInventoryId String?
  rootInventory   InventoryProduct?  @relation("ExchangeRoot", fields: [rootInventoryId], references: [id])
  chainMembers    InventoryProduct[] @relation("ExchangeRoot")

  // ── Which invoice brought this device in via exchange ──
  sourceInvoiceId String?
  sourceInvoice   Invoice? @relation("ExchangeInventory", fields: [sourceInvoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand?   @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  invoiceItem   InvoiceItem?
  buyingVariant BuyingVariant?

  @@index([imeiOrSerial])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([sellingCustomerEmail])
  @@index([sellingCustomerPhone])
  @@index([purchaseDate])
  @@index([sellingDate])
  @@index([status])
  @@index([parentInventoryId])
  @@index([rootInventoryId])
  @@index([sourceInvoiceId])
  @@map("inventory_products")
}

model InvoiceCompanySettings {
  id        String  @id @default(cuid())
  label     String
  isDefault Boolean @default(false)

  name     String
  address  String
  contact  String
  email    String
  gstin    String
  logoUrl  String?
  stampUrl String?

  defaultInvoiceTermsBrand   String @db.Text
  defaultInvoiceTermsHellofi String @db.Text
  defaultInvoiceTermsNone    String @db.Text
  defaultBankDetails         String @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@map("invoice_company_settings")
}

model InvoiceCounter {
  id            String   @id @default(cuid())
  financialYear String
  lastNumber    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([financialYear])
  @@map("invoice_counters")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  invoiceDate   DateTime

  companySettingsId String
  companySettings   InvoiceCompanySettings @relation(fields: [companySettingsId], references: [id])

  clientName          String
  clientAddress       String
  clientEmail         String
  clientContact       String
  clientGstin         String?
  isInsideBangalore   Boolean      @default(true)
  paidBy              PaymentMode?
  splitPaymentDetails String?

  saleType SaleType @default(DIRECT)

  warrantyType   InvoiceWarrantyType @default(BRAND)
  warrantyMonths Int?

  grossValue    Float
  taxAmount     Float
  totalAmount   Float
  exchangeValue Float @default(0)
  amountPaid    Float

  cgst Float @default(0)
  sgst Float @default(0)
  igst Float @default(0)

  customInvoiceTerms String? @db.Text
  customBankDetails  String? @db.Text

  pdfUrl String?

  status InvoiceStatus @default(DRAFT)

  items              InvoiceItem[]
  exchangeItems      InvoiceExchangeItem[]
  exchangedInventory InventoryProduct[]    @relation("ExchangeInventory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceNumber])
  @@index([clientEmail])
  @@index([clientContact])
  @@index([invoiceDate])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  inventoryProductId String?           @unique
  inventoryProduct   InventoryProduct? @relation(fields: [inventoryProductId], references: [id])

  product      String
  serialNumber String?
  hsnSac       String?

  qty      Int
  uom      String
  rate     Float
  total    Float
  discount Float  @default(0)
  gross    Float

  gstAmount   Float @default(0)
  cgstPercent Float @default(0)
  cgstAmount  Float @default(0)
  sgstPercent Float @default(0)
  sgstAmount  Float @default(0)
  igstPercent Float @default(0)
  igstAmount  Float @default(0)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([inventoryProductId])
  @@map("invoice_items")
}

model InvoiceExchangeItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productName   String
  serialNumber  String?
  brandId       String?
  categoryId    String?
  ram           String?
  storage       String?
  exchangeValue Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_exchange_items")
}

model Series {
  id         String   @id @default(cuid())
  brandId    String
  categoryId String
  seriesName String
  status     Status   @default(ACTIVE)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand           Brand            @relation(fields: [brandId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  sellingProducts SellingProduct[]

  @@map("series")
}

model SellingProduct {
  id             String    @id @default(cuid())
  productName    String
  productSeoName String    @unique
  brandId        String
  categoryId     String
  seriesId       String
  image          String
  releasedYear   Int?
  launchedDate   DateTime?
  productPrice   Float?
  status         Status    @default(ACTIVE)
  hasVariants    Boolean   @default(false)
  isConstantRam  Boolean   @default(false)
  ram            String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brand         Brand            @relation(fields: [brandId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  series        Series           @relation(fields: [seriesId], references: [id])
  variants      SellingVariant[]
  sellingOrders SellingOrder[]

  @@map("selling_products")
}

model SellingVariant {
  id               String   @id @default(cuid())
  sellingProductId String
  slug             String?  @unique // ← new field
  ram              String?
  storage          String
  productPrice     Float
  status           Status   @default(ACTIVE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sellingProduct SellingProduct @relation(fields: [sellingProductId], references: [id], onDelete: Cascade)
  sellingOrders  SellingOrder[]

  @@map("selling_variants")
}

model VideoReview {
  id           String          @id @default(uuid())
  title        String?
  videoUrl     String // S3 key of the video file
  thumbnailUrl String // S3 key of the thumbnail image
  type         VideoReviewType
  priority     Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("video_reviews")
}

enum BannerPlacement {
  HOME
  BUY_ALL
  BUY_MOBILE
  BUY_LAPTOP
  BUY_TABLET
  BUY_SMARTWATCH
  BUY_ACCESSORIES
  SELL_MOBILE
  SELL_LAPTOP
  SELL_TABLET
  SELL_SMARTWATCH
  SELL_ACCESSORIES
}

model Banner {
  id          String          @id @default(uuid())
  alt         String
  lg          String // desktop image (S3 key/url)
  sm          String // mobile image (S3 key/url)
  redirectUrl String? // where the banner links to on click
  placement   BannerPlacement @default(HOME) // where this banner shows
  priority    Int             @default(0) // ordering within a placement
  isActive    Boolean         @default(true)
  startDate   DateTime? // optional scheduling
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placement, isActive, priority])
  @@map("banners")
}

// ─────────────────────────────────────────────────────────────
// ASSESSMENT / SELLING FLOW MODELS
// ─────────────────────────────────────────────────────────────

enum StepCategory {
  DEVICE_OVERALL_CONDITION
  DEVICE_DEFECTS
  COSMETIC_CONDITION
  ACCESSORIES
  LAPTOP_SYSTEM_CONFIG
  PRICING
  BASICS
  SPECIFICATION
}

enum ConditionType {
  BOOLEAN
  RADIO
  MULTI_SELECT // Check to Deduct (Defects)
  MULTI_SELECT_INVERTED // Uncheck to Deduct (Accessories)
  DROPDOWN
}

enum OptionAction {
  INCREMENT
  DECREMENT
  REDIRECT
  NONE
}

enum ScoreType {
  PER
  RUPPEE
  MUL
}

enum RuleLogic {
  SKIP_ALL_OPTIONS
  APPLY_ONLY_SPECIFIC_OPTIONS
  SKIP_SELF
  APPLY_HIGHEST_PERCENTAGE
}

enum RedirectTarget {
  NEXT_STEP
  QUOTE_PAGE
  SPECIFIC_STEP
}

enum BrandVisibilityStrategy {
  INCLUDE
  EXCLUDE
  ALL
}

model Assessment {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  totalSteps  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  steps    AssessmentStep[]

  @@index([categoryId])
  @@map("assessments")
}

model AssessmentStep {
  id             String       @id @default(uuid())
  assessmentId   String
  stepCategory   StepCategory
  stepNumber     Int
  stepName       String
  title          String?
  subtitle       String?
  finalStepTitle String?
  description    String?
  priority       Int          @default(0)

  // Default navigation (self relation)
  defaultNextStepId String?
  defaultNextStep   AssessmentStep?  @relation("StepNavigation", fields: [defaultNextStepId], references: [id])
  previousSteps     AssessmentStep[] @relation("StepNavigation")

  // Brand visibility (replaces AssessmentStepBrandSkip)
  brandVisibilityStrategy BrandVisibilityStrategy @default(ALL)
  brandVisibility         BrandVisibility[]

  // Dependency logic — MUST match the relation names in AssessmentStepDependency
  dependsOn              AssessmentStepDependency[] @relation("StepToDependency")
  dependedOnByOtherSteps AssessmentStepDependency[] @relation("StepDependencyParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment               Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  conditions               SellingCondition[]
  assessmentStepBrandSkips AssessmentStepBrandSkip[]

  @@unique([assessmentId, stepNumber])
  @@index([assessmentId])
  @@map("assessment_steps")
}

model AssessmentStepBrandSkip {
  id      String @id @default(uuid())
  stepId  String
  brandId String

  step AssessmentStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, brandId])
  @@map("assessment_step_brand_skips")
}

model AssessmentStepDependency {
  id              String         @id @default(uuid())
  stepId          String
  dependsOnStepId String?
  conditionId     String?
  optionId        String?
  redirectTo      RedirectTarget @default(NEXT_STEP)
  specificStepId  String?

  // ⬇️ These two relations must have unique names, matching the ones above
  step          AssessmentStep  @relation("StepToDependency", fields: [stepId], references: [id], onDelete: Cascade)
  dependsOnStep AssessmentStep? @relation("StepDependencyParent", fields: [dependsOnStepId], references: [id])

  condition SellingCondition? @relation(fields: [conditionId], references: [id])
  option    SellingOption?    @relation(fields: [optionId], references: [id])

  @@map("assessment_step_dependencies")
}

model SellingCondition {
  id                 String        @id @default(uuid())
  stepId             String
  conditionType      ConditionType @default(RADIO)
  title              String
  subtitle           String?
  description        String?
  finalConditionName String?
  image              String?
  icon               String?
  priority           Int           @default(0)
  isRequired         Boolean       @default(false)

  // 👇 FIELDS FOR POPUPS (FIXED)
  parentOptionId String?
  parentOption   SellingOption? @relation("OptionPopup", fields: [parentOptionId], references: [id], onDelete: Cascade)

  // Date-based applicability
  applicableFromDate DateTime?

  // Brand visibility
  brandVisibilityStrategy BrandVisibilityStrategy @default(ALL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  step AssessmentStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  brandVisibility BrandVisibility[]
  options         SellingOption[]

  triggerRules   ConditionRuleTrigger[]
  targetRules    ConditionRule[]            @relation("ConditionRuleTargetCondition")
  dependencies   AssessmentStepDependency[]
  conditionRules ConditionRule[]            @relation("ConditionRuleCondition")

  @@index([stepId])
  @@map("selling_conditions")
}

model BrandVisibility {
  id          String                  @id @default(uuid())
  stepId      String?
  conditionId String?
  optionId    String?
  strategy    BrandVisibilityStrategy @default(ALL)
  brandId     String?
  brandName   String?

  // exactly one of stepId / conditionId / optionId is set
  step      AssessmentStep?   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  condition SellingCondition? @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  option    SellingOption?    @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([conditionId])
  @@index([optionId])
  @@map("brand_visibilities")
}

model SellingOption {
  id          String       @id @default(uuid())
  conditionId String
  label       String
  action      OptionAction @default(NONE)
  score       Int          @default(0)
  scoreType   ScoreType    @default(PER)
  isRedirect  Boolean      @default(false)
  redirectTo  String?
  priority    Int          @default(0)
  title       String?
  description String?
  isSelected  Boolean      @default(false)

  image String?

  // Brand visibility (same table as conditions)
  brandVisibilityStrategy BrandVisibilityStrategy @default(ALL)
  brandVisibility         BrandVisibility[]

  // Link to the popup condition
  popupConditions SellingCondition[] @relation("OptionPopup")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  condition SellingCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  brandScores   OptionBrandScore[]
  seriesScores  OptionSeriesScore[]
  productScores OptionProductScore[]
  triggerRules  ConditionRuleTrigger[]
  targetRules   ConditionRule[]            @relation("ConditionRuleTargetOption")
  dependencies  AssessmentStepDependency[]

  @@index([conditionId])
  @@map("selling_options")
}

model OptionBrandScore {
  id        String       @id @default(uuid())
  optionId  String
  brandId   String
  brandName String?
  score     Int
  scoreType ScoreType
  action    OptionAction

  option SellingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, brandId])
  @@map("option_brand_scores")
}

model OptionSeriesScore {
  id         String       @id @default(uuid())
  optionId   String
  seriesId   String
  seriesName String?
  score      Int
  scoreType  ScoreType
  action     OptionAction

  option SellingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, seriesId])
  @@map("option_series_scores")
}

model OptionProductScore {
  id          String       @id @default(uuid())
  optionId    String
  productId   String
  productName String?
  score       Int
  scoreType   ScoreType
  action      OptionAction

  option SellingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, productId])
  @@map("option_product_scores")
}

model ConditionRule {
  id          String    @id @default(uuid())
  conditionId String
  ruleName    String?
  description String?
  ruleLogic   RuleLogic

  ruleBrandStrategy BrandVisibilityStrategy @default(ALL)

  targetConditionId String?
  highestScoreType  ScoreType    @default(PER)
  highestAction     OptionAction @default(DECREMENT)

  targetOptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  condition       SellingCondition       @relation("ConditionRuleCondition", fields: [conditionId], references: [id], onDelete: Cascade)
  targetCondition SellingCondition?      @relation("ConditionRuleTargetCondition", fields: [targetConditionId], references: [id])
  targetOption    SellingOption?         @relation("ConditionRuleTargetOption", fields: [targetOptionId], references: [id])
  triggers        ConditionRuleTrigger[]
  ruleBrands      ConditionRuleBrand[]

  @@index([conditionId])
  @@map("condition_rules")
}

model ConditionRuleTrigger {
  id          String @id @default(uuid())
  ruleId      String
  conditionId String
  optionId    String
  logic       String @default("OR") // AND / OR

  rule      ConditionRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  condition SellingCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  option    SellingOption    @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("condition_rule_triggers")
}

model ConditionRuleBrand {
  id        String  @id @default(uuid())
  ruleId    String
  brandId   String?
  brandName String?

  rule ConditionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("condition_rule_brands")
}

// 👇 Add these Enums at the top with your other enums
enum OrderStatus {
  AWAITING_ADDRESS
  AWAITING_PICKUP
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  UPI
  BANK
  CASH
}

enum AddressType {
  HOME
  WORK
  OTHER
}

// 👇 The main Order Model
model SellingOrder {
  id      String @id @default(uuid())
  orderNo String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sellingProductId String
  sellingProduct   SellingProduct @relation(fields: [sellingProductId], references: [id])

  variantId String?
  variant   SellingVariant? @relation(fields: [variantId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  // Snapshots
  productName  String
  productImage String?
  brandName    String
  categoryName String
  variantName  String?

  // Pricing
  listedPrice         Float  @default(0)
  basePrice           Float  @default(0)
  quotedPriceBySystem Float  @default(0)
  quotedPrice         Float?
  pickupCharges       Float  @default(0)
  processingFee       Float  @default(0)
  totalAmount         Float  @default(0)

  // What the user answered
  selectedAnswers Json
  accessories     Json?
  priceBreakdown  Json?

  // Order state
  orderStatus     OrderStatus @default(AWAITING_ADDRESS)
  currentStep     Int         @default(1)
  isFullFilled    Boolean     @default(false)
  isLowValue      Boolean     @default(false)
  isAgreedToTerms Boolean     @default(false)
  invoiceLink     String?

  // Timeline template, matched by NAME (e.g. "pickup via us")
  orderTimelineName String?
  timeline          Timeline? @relation(fields: [orderTimelineName], references: [name])

  // Timeline history (what actually happened on this order)
  timelineEvents OrderTimeline[]

  // Address (snapshot at order time)
  address          Json?
  serviceAvailable Boolean @default(false)

  // Fulfilment method
  pickupMethod   String? // "self" | "pickup-via-us" | "pickup-via-staff"
  isDropToOffice Boolean @default(false)

  dropToOfficeDate        String?
  dropToOfficeISODate     String?
  dropToOfficeSlotTimings String?

  selfShipDate    String?
  selfShipISODate String?

  pickupDate    String?
  pickupISODate String?
  pickupSlot    String?

  serialOrIMEI    String?
  additionalNotes String?

  // Payment
  paymentMethod  PaymentMethod?
  paymentDetails Json?

  // WhatsApp
  isWhatsAppFollowUpSent     Boolean @default(false)
  isWhatsAppFollowUpRequired Boolean @default(false)

  // Followup tracking
  followupStatus        String?
  followupCount         Int       @default(0)
  followupNotes         Json?
  followupScheduledDate DateTime?
  lastFollowupDate      DateTime?
  contactCity           String?
  hasContactInCity      Boolean   @default(false)
  customerResponse      String?
  isFollowupConverted   Boolean   @default(false)
  followupConvertedDate DateTime?
  addressId             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderStatus])
  @@index([orderTimelineName])
  @@index([orderStatus, followupStatus, followupScheduledDate])
  @@map("selling_orders")
}

// History: one row each time the order reaches a step
model OrderTimeline {
  id      String       @id @default(uuid())
  orderId String
  order   SellingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  label       String
  message     String?
  description String?
  status      String // matches TimelineStep.status

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, createdAt])
  @@map("order_timeline")
}

// Template: predefined timelines
model Timeline {
  id       String  @id @default(uuid())
  name     String  @unique // "pickup via us", "self ship", "drop to office", ...
  isActive Boolean @default(true)

  steps  TimelineStep[]
  orders SellingOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("timelines")
}

model TimelineStep {
  id         String   @id @default(uuid())
  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  status   String // "created", "pickuprequested", ...
  label    String // text shown in the frontend
  position Int // 1, 2, 3... controls the order

  @@unique([timelineId, position])
  @@unique([timelineId, status])
  @@map("timeline_steps")
}

model ServiceablePincode {
  id                      String   @id @default(uuid())
  city                    String
  pinCodes                String[] // Postgres array
  isDropToOfficeAvailable Boolean  @default(false)
  isActive                Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([pinCodes], type: Gin) // fast "is this pincode serviceable" lookup
  @@map("serviceable_pincodes")
}

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  contact            String
  alternateContactNo String?
  email              String
  address            String
  pinCode            String
  landMark           String?
  cityDistrict       String
  state              String
  gst                String?
  addressType        AddressType @default(HOME)
  isDefault          Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}
